# ─────────────────────────────────────────────────────────────────────────────
# LOGMAS backend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3006
NODE_ENV=development

# ─── Database (one Postgres database per LGA deployment) ─────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/logmas_lga

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ─── LGA identity (see src/config/lga.config.ts) ─────────────────────────────
# Defaults to the built-in preset when unset. A new LGA sets these AND drops
# prisma/data/<LGA_ID>.services.json — no code edits required.
LGA_ID=ijebu-north-east
LGA_NAME=Ijebu North East
LGA_FULL_NAME=Ijebu North East Local Government
LGA_SHORT_CODE=INE
LGA_ACCOUNT_PREFIX=IJEBUNORTHEAST

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://www.example-lga.gov.ng
BACKEND_URL=https://api.example-lga.logmas.com.ng
API_BASE_URL=https://api.example-lga.logmas.com.ng/api/v1

# ─── Payments — GPay (per-LGA merchant) ──────────────────────────────────────
GPAY_BASE_URL=https://gpay.gfa-tech.com/api/v1
GPAY_API_KEY=
GPAY_AUTH_SECRET=
GPAY_WEBHOOK_SECRET=
# Per-LGA merchant identity. The merchant code must match the GPay account
# provisioned for this LGA (e.g. "ijebunortheastlga").
GPAY_MERCHANT_ID=
GPAY_MERCHANT_CODE=
# Full public URL of the webhook route, e.g. https://api.<lga>.logmas.com.ng/api/v1/payments/gpay/webhook
GPAY_WEBHOOK_URL=
# Frontend return URL — the site root (no trailing /payment/result path)
GPAY_RETURN_URL=https://www.example-lga.gov.ng
GPAY_USE_DIRECT_CHECKOUT=false
GPAY_DYNAMIC_ACCOUNT_EXPIRY_MINUTES=15
GPAY_TIMEOUT_MS=15000

# ─── Payments — Paystack (optional legacy provider) ──────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# ─── Notifications — Termii SMS ──────────────────────────────────────────────
TERMII_API_KEY=
TERMII_BASE_URL=https://api.termii.com/api
TERMII_CHANNEL=dnd
TERMII_SENDER_ID=
NOTIFICATION_TEST_MODE=false
TEST_RECIPIENT_EMAIL=
TEST_RECIPIENT_PHONE=

# ─── OAuth (optional) ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
